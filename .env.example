TRADING_AGENT_MODE=paper
TRADING_AGENT_MOOMOO_HOST=127.0.0.1
TRADING_AGENT_MOOMOO_PORT=11111
TRADING_AGENT_SECURITY_FIRM=FUTUMY
TRADING_AGENT_ACCOUNT_ID=
# Live mode remains disabled unless this exact acknowledgment is set manually.
TRADING_AGENT_ENABLE_LIVE=
# Operator-pinned allowlist of approved live account id(s), comma-separated.
# Required for live mode; keep your real account id out of version control.
TRADING_AGENT_LIVE_ACCOUNT_ALLOWLIST=

# LLM research committee (OpenAI-compatible endpoint, e.g. DeepSeek).
# Never commit a real key. Paste the key into your local .env only.
TRADING_AGENT_LLM_API_KEY=
TRADING_AGENT_LLM_BASE_URL=https://api.deepseek.com
# Primary (flash) model runs the four analyst/critic roles.
TRADING_AGENT_LLM_MODEL=deepseek-v4-flash
# Pro model runs only the decisive portfolio_manager.
TRADING_AGENT_LLM_MODEL_PRO=deepseek-v4-pro

# Optional cross-provider adversary for the skeptic / risk_manager roles. Point
# it at a DIFFERENT model lineage (e.g. Gemini, Qwen, a Groq-hosted Llama) so the
# veto roles produce a genuinely independent second opinion instead of the same
# model grading itself. Leave the model blank to reuse the primary model.
# Base URL and key fall back to the primary endpoint when left blank.
TRADING_AGENT_LLM_ADVERSARY_API_KEY=
TRADING_AGENT_LLM_ADVERSARY_BASE_URL=
TRADING_AGENT_LLM_ADVERSARY_MODEL=

# SEC EDGAR requires a descriptive User-Agent with contact info.
TRADING_AGENT_SEC_USER_AGENT=Your Name your-email@example.com

